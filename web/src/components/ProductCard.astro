---
import { urlForImage } from '../utils/sanity';

export interface Props {
  product: {
    _id: string;
    name: string;
    price: number;
    stock: number;
    description?: string;
    image?: any;
  };
}

const { product } = Astro.props;
const isOut = product.stock <= 0;
// Adjust aspect ratio for a more premium look (4:5)
const imageUrl = product.image ? urlForImage(product.image).width(600).height(750).url() : '';
---

<div class="artwork-card" class:list={[{ 'is-sold': isOut }]}>
  <div class="artwork-image-wrapper">
    {imageUrl ? (
      <img src={imageUrl} alt={product.name} loading="lazy" class="artwork-image" />
    ) : (
      <div class="artwork-image-placeholder">Sin imagen</div>
    )}
    {isOut && <div class="badge-sold">Vendido</div>}

    <div class="artwork-overlay">
      <button 
        class="inquiry-btn add-to-cart-btn" 
        disabled={isOut}
        data-id={product._id}
        data-name={product.name}
        data-price={product.price}
      >
        {isOut ? 'Obra Vendida' : 'Consultar Obra'}
      </button>
    </div>
  </div>
  
  <div class="artwork-info">
    <h3 class="artwork-name">{product.name}</h3>
    {/* Price is hidden to encourage inquiry, typical for art */}
    {/* <p class="artwork-price">${product.price.toLocaleString('es-AR')}</p> */}
    {product.description && <p class="artwork-desc">{product.description}</p>}
  </div>
</div>

<style>
  .artwork-card {
    background: transparent;
    border: none;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 20px;
    margin-bottom: 30px;
  }
  
  .artwork-card.is-sold {
    opacity: 0.85;
  }

  .artwork-image-wrapper {
    position: relative;
    width: 100%;
    /* Keep a flexible aspect ratio for art, or default to 4/5 if strictly needed. 
       Removing aspect-ratio allows masonry to work with natural heights if images aren't cropped. */
    background: var(--color-surface);
    overflow: hidden;
  }

  .artwork-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94), filter 0.5s ease;
  }
  
  .artwork-card:not(.is-sold):hover .artwork-image {
    transform: scale(1.03);
    filter: brightness(0.9);
  }

  .artwork-image-placeholder {
    width: 100%;
    aspect-ratio: 4/5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-style: italic;
    font-family: var(--font-body);
  }

  .badge-sold {
    position: absolute;
    top: 15px;
    right: 15px;
    background: rgba(26, 26, 26, 0.9);
    color: #FFFFFF;
    font-size: 0.7rem;
    font-family: var(--font-body);
    font-weight: 400;
    padding: 8px 16px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    z-index: 2;
  }

  /* Overlay that slides up */
  .artwork-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 30px;
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 1;
  }

  .artwork-card:hover .artwork-overlay {
    opacity: 1;
  }

  .inquiry-btn {
    width: 80%;
    background: rgba(255, 255, 255, 0.95);
    color: #1A1A1A;
    border: 1px solid transparent;
    padding: 16px;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
    transform: translateY(20px);
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .artwork-card:hover .inquiry-btn {
    transform: translateY(0);
  }

  .inquiry-btn:not(:disabled):hover {
    background: #1A1A1A;
    color: #FFFFFF;
    border-color: #1A1A1A;
  }

  .inquiry-btn:disabled {
    background: rgba(255, 255, 255, 0.7);
    color: var(--color-text-muted);
    cursor: not-allowed;
  }

  .artwork-info {
    display: flex;
    flex-direction: column;
    padding: 0 10px;
    text-align: center;
  }

  .artwork-name {
    font-size: 1.25rem;
    color: var(--color-text);
    margin-bottom: 8px;
    line-height: 1.4;
    letter-spacing: 0.15em;
  }

  .artwork-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-family: var(--font-body);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;  
    overflow: hidden;
  }
</style>
