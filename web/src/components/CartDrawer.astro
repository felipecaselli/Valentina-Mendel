---
export interface Props {
  whatsappNumber: string;
}

const { whatsappNumber } = Astro.props;
---

<div id="cart-drawer" class="cart-drawer" aria-hidden="true">
  <div class="cart-overlay" id="cart-close-overlay"></div>
  <div class="cart-content">
    <div class="cart-header">
      <h2>Tus Consultas</h2>
      <button id="cart-close-btn" class="close-btn">&times;</button>
    </div>
    
    <div class="cart-items" id="cart-items-container">
      <!-- Items dynamically injected here -->
      <p class="cart-empty-msg">No has seleccionado ninguna obra.</p>
    </div>
    
    <div class="cart-footer">
      <button id="checkout-btn" class="checkout-btn" data-whatsapp={whatsappNumber} disabled>
        Contactar por WhatsApp
      </button>
    </div>
  </div>
</div>

<button id="cart-floating-btn" class="cart-floating-btn">
  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
    <polyline points="22,6 12,13 2,6"></polyline>
  </svg>
  <span id="cart-count" class="cart-count">0</span>
</button>

<script>
  let cart = JSON.parse(localStorage.getItem('whatsapp_store_cart') || '[]');
  
  const drawer = document.getElementById('cart-drawer');
  const overlay = document.getElementById('cart-close-overlay');
  const closeBtn = document.getElementById('cart-close-btn');
  const floatingBtn = document.getElementById('cart-floating-btn');
  const itemsContainer = document.getElementById('cart-items-container');
  const checkoutBtn = document.getElementById('checkout-btn');
  const cartCountEl = document.getElementById('cart-count');

  function saveCart() {
    localStorage.setItem('whatsapp_store_cart', JSON.stringify(cart));
    renderCart();
  }

  function openCart() {
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeCart() {
    drawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  overlay.addEventListener('click', closeCart);
  closeBtn.addEventListener('click', closeCart);
  floatingBtn.addEventListener('click', openCart);

  // Listen to Add to Cart clicks anywhere
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.add-to-cart-btn');
    if (btn && !btn.disabled) {
      const id = btn.getAttribute('data-id');
      const name = btn.getAttribute('data-name');
      
      const existing = cart.find(item => item.id === id);
      if (!existing) {
        cart.push({ id, name });
      }
      saveCart();
      openCart();
    }
    
    // Listen to remove item clicks
    const removeBtn = e.target.closest('.remove-item-btn');
    if (removeBtn) {
      const id = removeBtn.getAttribute('data-id');
      cart = cart.filter(item => item.id !== id);
      saveCart();
    }
  });

  function renderCart() {
    if (cart.length === 0) {
      itemsContainer.innerHTML = '<p class="cart-empty-msg">No has seleccionado ninguna obra.</p>';
      cartCountEl.textContent = '0';
      cartCountEl.style.display = 'none';
      checkoutBtn.disabled = true;
      return;
    }

    let count = cart.length;
    
    itemsContainer.innerHTML = cart.map(item => {
      return `
        <div class="cart-item">
          <div>
            <div class="cart-item-name">${item.name}</div>
          </div>
          <button class="remove-item-btn" data-id="${item.id}">&times;</button>
        </div>
      `;
    }).join('');

    cartCountEl.textContent = count.toString();
    cartCountEl.style.display = 'flex';
    checkoutBtn.disabled = false;
  }

  checkoutBtn.addEventListener('click', () => {
    const number = checkoutBtn.getAttribute('data-whatsapp');
    let message = "¡Hola! Estoy interesado en las siguientes obras:\n\n";
    
    cart.forEach(item => {
      message += `- ${item.name}\n`;
    });
    
    message += `\nQuisiera consultar disponibilidad y precios. ¡Gracias!`;
    
    const encodedMessage = encodeURIComponent(message);
    const url = `https://wa.me/${number}?text=${encodedMessage}`;
    
    window.open(url, '_blank');
    
    // Clear cart after redirect
    cart = [];
    saveCart();
    closeCart();
  });

  // Initial render
  renderCart();
</script>

<style>
  .cart-drawer[aria-hidden="true"] {
    visibility: hidden;
  }
  
  .cart-drawer[aria-hidden="true"] .cart-content {
    transform: translateX(100%);
  }
  
  .cart-drawer[aria-hidden="true"] .cart-overlay {
    opacity: 0;
  }

  .cart-drawer {
    position: fixed;
    inset: 0;
    z-index: 50;
    visibility: visible;
    transition: visibility 0.4s ease;
  }

  .cart-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.8);
    opacity: 1;
    transition: opacity 0.4s ease;
    backdrop-filter: blur(5px);
  }

  .cart-content {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 450px;
    background: #FFFFFF;
    box-shadow: -10px 0 40px rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;
    transform: translateX(0);
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .cart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 40px 30px 20px;
  }

  .cart-header h2 {
    font-size: 1.25rem;
    letter-spacing: 0.15em;
    margin: 0;
  }

  .close-btn {
    background: transparent;
    border: none;
    font-size: 2rem;
    color: var(--color-text-muted);
    transition: color 0.3s ease;
    line-height: 1;
  }

  .close-btn:hover {
    color: var(--color-text);
  }

  .cart-items {
    flex-grow: 1;
    overflow-y: auto;
    padding: 0 30px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 20px;
  }

  .cart-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-border);
  }

  .cart-item-name {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    letter-spacing: 0.05em;
  }

  .remove-item-btn {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    font-size: 1.5rem;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.3s ease;
  }

  .remove-item-btn:hover {
    color: #000;
  }

  .cart-empty-msg {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-style: italic;
    margin-top: 20px;
  }

  .cart-footer {
    padding: 40px 30px;
    background: #FFFFFF;
  }

  .checkout-btn {
    width: 100%;
    background: #1A1A1A;
    color: white;
    border: 1px solid #1A1A1A;
    padding: 18px;
    font-family: var(--font-heading);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .checkout-btn:not(:disabled):hover {
    background: transparent;
    color: #1A1A1A;
  }

  .checkout-btn:disabled {
    background: #F0F0F0;
    color: #999;
    border-color: #F0F0F0;
    cursor: not-allowed;
  }

  .cart-floating-btn {
    position: fixed;
    bottom: 30px;
    right: 30px;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #FFFFFF;
    color: #1A1A1A;
    border: 1px solid #EEEEEE;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    z-index: 40;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .cart-floating-btn:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
  }

  .cart-count {
    position: absolute;
    top: -5px;
    right: -5px;
    background: #1A1A1A;
    color: white;
    font-size: 0.7rem;
    font-family: var(--font-body);
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
